# -----------------------------------------------------------------------------
# Project NEXUS Environment Variables
# Copy this file to .env and update the values for your local/production environment.
# -----------------------------------------------------------------------------

# Core
DEBUG=true
ENVIRONMENT=development

# Security
SECRET_KEY=your-super-secret-key-change-in-production

# PostgreSQL (Local Dev matches docker-compose.yml)
POSTGRES_USER=nexus_user
POSTGRES_PASSWORD=nexus_secure_password_local
POSTGRES_SERVER=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=nexus_db
POSTGRES_SSL=false
DB_ECHO=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_USE_TLS=false

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8000

# RabbitMQ
RABBITMQ_USER=nexus_rabbit
RABBITMQ_PASSWORD=nexus_rabbit_pass_local
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

# LLM Providers (Add your free-tier keys here)
DEFAULT_LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Docker Compose host ports and browser-facing backend URLs
FRONTEND_HOST_PORT=5174
BACKEND_HOST_PORT=8001
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6379
VITE_API_BASE_URL=http://localhost:8001
VITE_WEBSOCKET_URL=ws://localhost:8001/ws
FRONTEND_ORIGIN=http://localhost:5174

# Optional, resource-intensive AI dependency set (also use --profile ai)
INSTALL_AI=false