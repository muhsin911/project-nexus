# -----------------------------------------------------------------------------
# Project NEXUS Environment Variables
# Copy this file to .env and update the values for your local/production environment.
# -----------------------------------------------------------------------------

# Core
DEBUG=true
ENVIRONMENT=development

# Security
SECRET_KEY=your-super-secret-key-change-in-production

# PostgreSQL (Local Dev matches docker-compose.yml)
POSTGRES_USER=nexus_user
POSTGRES_PASSWORD=nexus_secure_password_local
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nexus_db
DB_ECHO=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8000

# RabbitMQ
RABBITMQ_USER=nexus_rabbit
RABBITMQ_PASSWORD=nexus_rabbit_pass_local
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

# LLM Providers (Add your free-tier keys here)
DEFAULT_LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here